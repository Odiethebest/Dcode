# ============================================================
# Dcode production environment variables.
#
# Copy to `.env.production` on the deployment host and review every
# placeholder before:
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# `docker-compose.prod.yml` is a COMPLETE stack, not an overlay. Do not
# combine it with `-f docker-compose.yml`: the developer file publishes
# Postgres, Redis and the RabbitMQ management UI to the host, and overlaying
# would republish them on a public machine.
# ============================================================

# --- Public entrypoint ---
PUBLIC_HTTP_PORT=80
PUBLIC_ORIGIN=http://dcode.odieyang.com

# --- PostgreSQL ---
POSTGRES_USER=dcode
POSTGRES_PASSWORD=__SET_PROD_POSTGRES_PASSWORD__
POSTGRES_DB=dcode

# --- Internal services ---
RABBITMQ_USER=__SET_PROD_RABBITMQ_USER__
RABBITMQ_PASSWORD=__SET_PROD_RABBITMQ_PASSWORD__

# The compose file builds DATABASE_URL / REDIS_URL / RABBITMQ_URL / AGENT_URL
# from the values above and the internal service names, so these four are NOT
# read by the running stack. They are here for commands run against this env
# file outside compose (an alembic invocation on the host, for example). If you
# change a credential above, change it here too or leave these out entirely.
DATABASE_URL=postgresql+asyncpg://dcode:__SET_PROD_POSTGRES_PASSWORD__@postgres:5432/dcode
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://__SET_PROD_RABBITMQ_USER__:__SET_PROD_RABBITMQ_PASSWORD__@rabbitmq:5672/
AGENT_URL=http://agent:8001

# --- Internal service auth ---
# Protects every /internal/* retrieval and graph route. The code default is a
# placeholder published in this repository, so this must be set to a real
# secret — the compose file refuses to start without it.
INTERNAL_API_KEY=__SET_PROD_INTERNAL_API_KEY__

LOG_LEVEL=info

# ============================================================
# Retrieval models
#
# These are read by api, worker AND agent, and they must AGREE. The API embeds
# the search query, the worker embeds the corpus, and the agent reranks its own
# evidence union. Configuring one service and not another produces no error —
# it produces real vectors in the database being searched with a stub all-zero
# query vector, i.e. dense retrieval silently returning noise.
# ============================================================

# EMBEDDING_DIM is fixed into the pgvector column by the migration and cannot
# be changed afterwards without a new volume. It has no default in production
# for that reason: a wrong value here is not a slow query, it is a re-index.
# stub = 1024 zero vectors; jinaai/jina-embeddings-v2-base-code = 768.
EMBEDDING_MODEL=stub
EMBEDDING_DIM=1024
EMBEDDING_ENDPOINT=

# Sized for a cold self-hosted sidecar. 12 retries against a 300s timeout can
# hold one batch of four chunks for about an hour, and the worker consumes one
# job at a time, so everything queued behind it waits. Lower both substantially
# when the endpoint is a hosted API rather than a model loading on CPU.
# EMBEDDING_BATCH_SIZE=4
# EMBEDDING_MAX_RETRIES=12
# EMBEDDING_TIMEOUT_SECONDS=300

# Leave RERANKER_ENDPOINT empty unless RERANKER_MODEL is a real model. A
# non-stub model with an empty endpoint fails fast and loudly, which is the
# intended behaviour; a stub model ignores the endpoint entirely.
RERANKER_MODEL=stub
RERANKER_ENDPOINT=
# RERANKER_CANDIDATE_LIMIT=16
# RERANKER_MAX_RETRIES=3

# Hybrid RRF fusion weights. Dense above sparse reduces keyword noise.
# RRF_DENSE_WEIGHT=2.0
# RRF_SPARSE_WEIGHT=1.0

# ============================================================
# Answer synthesis
# ============================================================

# 'stub' keeps rule-based template answers. Set an OpenAI-compatible model and
# key for prose answers; citations are verified against the index either way.
SYNTHESIS_MODEL=stub
OPENAI_API_KEY=
OPENAI_BASE_URL=
# SYNTHESIS_MAX_TOKENS=700
# SYNTHESIS_TEMPERATURE=0.1

# Keep above 0 in production so the groundedness guardrail stays enforced.
# GROUNDEDNESS_THRESHOLD=0.95

# Defined and passed through, but read by no code today. Left in place rather
# than removed, because removing dead configuration is a product decision.
JUDGE_MODEL=stub
