# ============================================================
# Dcode production environment variables.
#
# Copy to `.env.production` on the deployment host and review every
# placeholder before:
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# `docker-compose.prod.yml` is a COMPLETE stack, not an overlay. Do not
# combine it with `-f docker-compose.yml`: the developer file publishes
# Postgres, Redis and the RabbitMQ management UI to the host, and overlaying
# would republish them on a public machine.
# ============================================================

# --- Public entrypoint ---
PUBLIC_HTTP_PORT=80
PUBLIC_ORIGIN=http://dcode.odieyang.com

# --- PostgreSQL ---
POSTGRES_USER=dcode
POSTGRES_PASSWORD=__SET_PROD_POSTGRES_PASSWORD__
POSTGRES_DB=dcode

# --- Internal services ---
RABBITMQ_USER=__SET_PROD_RABBITMQ_USER__
RABBITMQ_PASSWORD=__SET_PROD_RABBITMQ_PASSWORD__

# The compose file builds DATABASE_URL / REDIS_URL / RABBITMQ_URL / AGENT_URL
# from the values above and the internal service names, so these four are NOT
# read by the running stack. They are here for commands run against this env
# file outside compose (an alembic invocation on the host, for example). If you
# change a credential above, change it here too or leave these out entirely.
DATABASE_URL=postgresql+asyncpg://dcode:__SET_PROD_POSTGRES_PASSWORD__@postgres:5432/dcode
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://__SET_PROD_RABBITMQ_USER__:__SET_PROD_RABBITMQ_PASSWORD__@rabbitmq:5672/
AGENT_URL=http://agent:8001

# ============================================================
# The shared-account gate (Deploy.md D-2 / D-6)
#
# docker-compose.prod.yml hardcodes AUTH_ENABLED=true, so production is gated
# whether or not this file says so, and the API refuses to start if the two
# required values below are missing. Both are secrets: they belong here, in a
# gitignored file, and never in a committed one.
#
# Generate the hash (prompts without echoing, never takes an argument, so the
# password stays out of shell history and the process list):
#
#   python -m dcode_api.hash_password
#
# One shared account. There is no user table and no per-person revocation —
# to remove someone's access, rotate the password. That is the cost of D-6 and
# it is recorded there rather than discovered here.
# ============================================================
AUTH_USERNAME=reviewer
AUTH_PASSWORD_HASH=__SET_PROD_AUTH_PASSWORD_HASH__
AUTH_SESSION_SECRET=

# 12 hours. A reviewer session outliving a sitting is the intent.
# AUTH_SESSION_TTL_SECONDS=43200

# Leave true on Railway and anywhere else serving HTTPS. Set false ONLY for a
# plain-HTTP staging host: browsers silently drop a Secure cookie over http,
# so logins there appear to succeed and never stick.
# AUTH_COOKIE_SECURE=true

# The gate stops anonymous callers; it does nothing about a signed-in one
# looping a question through three metered APIs. Counted per session per UTC
# day, checked before the agent is reached.
# AUTH_DAILY_QUERY_LIMIT=200

# --- Internal service auth ---
# Protects every /internal/* retrieval and graph route. The code default is a
# placeholder published in this repository, so this must be set to a real
# secret — the compose file refuses to start without it.
INTERNAL_API_KEY=__SET_PROD_INTERNAL_API_KEY__

LOG_LEVEL=info

# Optional clone-target allowlist. Empty means any public host, which is what a
# demo indexing arbitrary open-source repositories needs. Set it and it becomes
# the only rule in the URL check that states what is allowed rather than what is
# obviously wrong. Subdomains match.
# REPO_URL_ALLOWED_HOSTS=github.com,gitlab.com

# Cloned checkouts were never removed, so the volume grew with every distinct
# repository anyone submitted. 0 keeps that. Setting a cap evicts the oldest
# checkouts before a clone — an evicted repository keeps search and the call
# graph (those read Postgres) and loses read_file / grep / list_directory until
# it is re-indexed. Pick a number that fits the volume.
# WORKDIR_MAX_REPOS=8

# ============================================================
# Retrieval models
#
# These are read by api, worker AND agent, and they must AGREE. The API embeds
# the search query, the worker embeds the corpus, and the agent reranks its own
# evidence union. Configuring one service and not another produces no error —
# it produces real vectors in the database being searched with a stub all-zero
# query vector, i.e. dense retrieval silently returning noise.
# ============================================================

# EMBEDDING_DIM is fixed into the pgvector column by the migration and cannot
# be changed afterwards without a new volume. It has no default in production
# for that reason: a wrong value here is not a slow query, it is a re-index.
# stub = 1024 zero vectors; jinaai/jina-embeddings-v2-base-code = 768.
EMBEDDING_MODEL=stub
EMBEDDING_DIM=1024
EMBEDDING_ENDPOINT=

# EMBEDDING_PROVIDER selects HOW the model is reached, never WHICH model runs.
# 'sidecar' expects a self-hosted service; 'jina_api' calls Jina AI's hosted
# endpoint. Both serve jina-embeddings-v2-base-code, which is the point: the
# evaluation figures this project displays describe that model, so the deployed
# system has to be running it (Deploy.md §2). Switch as a SET — the model id is
# the bare name on the API, and the sidecar retry budget is an hour of patience
# pointed at a service that fails in seconds.
# EMBEDDING_PROVIDER=jina_api
# EMBEDDING_API_KEY=jina_...
# EMBEDDING_ENDPOINT=https://api.jina.ai/v1
# EMBEDDING_MODEL=jina-embeddings-v2-base-code
# EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_TIMEOUT_SECONDS=30

# Sized for a cold self-hosted sidecar. 12 retries against a 300s timeout can
# hold one batch of four chunks for about an hour, and the worker consumes one
# job at a time, so everything queued behind it waits. Lower both substantially
# when the endpoint is a hosted API rather than a model loading on CPU.
# EMBEDDING_BATCH_SIZE=4
# EMBEDDING_MAX_RETRIES=12
# EMBEDDING_TIMEOUT_SECONDS=300

# Leave RERANKER_ENDPOINT empty unless RERANKER_MODEL is a real model. A
# non-stub model with an empty endpoint fails fast and loudly, which is the
# intended behaviour; a stub model ignores the endpoint entirely.
RERANKER_MODEL=stub
RERANKER_ENDPOINT=
# RERANKER_CANDIDATE_LIMIT=16
# RERANKER_MAX_RETRIES=3

# Or the same model through SiliconFlow's hosted API. Their two platforms are
# independent and keys are NOT interchangeable: api.siliconflow.cn serves
# BAAI/bge-reranker-v2-m3, while api.siliconflow.com served only Qwen rerankers
# when this was written. A .com key against .cn returns 401 with "Api key is
# invalid", which looks like a bad key rather than a wrong region.
# RERANKER_PROVIDER=siliconflow
# RERANKER_API_KEY=sk-...
# RERANKER_ENDPOINT=https://api.siliconflow.cn/v1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Hybrid RRF fusion weights. Dense above sparse reduces keyword noise.
# RRF_DENSE_WEIGHT=2.0
# RRF_SPARSE_WEIGHT=1.0

# ============================================================
# Answer synthesis
# ============================================================

# 'stub' keeps rule-based template answers. Set an OpenAI-compatible model and
# key for prose answers; citations are verified against the index either way.
SYNTHESIS_MODEL=stub
OPENAI_API_KEY=
OPENAI_BASE_URL=
# SYNTHESIS_MAX_TOKENS=700
# SYNTHESIS_TEMPERATURE=0.1

# Keep above 0 in production so the groundedness guardrail stays enforced.
# GROUNDEDNESS_THRESHOLD=0.95

# Defined and passed through, but read by no code today. Left in place rather
# than removed, because removing dead configuration is a product decision.
JUDGE_MODEL=stub
