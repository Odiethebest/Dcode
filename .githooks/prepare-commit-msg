#!/usr/bin/env sh
set -eu

message_file="$1"

coauthor_name="${CODEX_COAUTHOR_NAME:-Codex}"
coauthor_email="${CODEX_COAUTHOR_EMAIL:-codex@openai.com}"
coauthor_line="Co-authored-by: ${coauthor_name} <${coauthor_email}>"

if grep -qi "^Co-authored-by: .*<${coauthor_email}>$" "$message_file"; then
  exit 0
fi

{
  printf "\n"
  printf "%s\n" "$coauthor_line"
} >> "$message_file"
