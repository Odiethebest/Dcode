# ============================================================
# Dcode environment variables.
# Copy to .env and fill in. Never commit .env.
#
# These values are the host-side defaults (used when you run
# `uv run` or `npm run dev` directly on the host).
# `docker compose up` overrides hostnames in docker-compose.yml
# to internal docker network names (postgres, redis, rabbitmq).
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=dcode
POSTGRES_PASSWORD=__SET_LOCAL_DEV_POSTGRES_PASSWORD__
POSTGRES_DB=dcode

# --- Service URLs (host-side defaults) ---
DATABASE_URL=postgresql+asyncpg://dcode:__SET_LOCAL_DEV_POSTGRES_PASSWORD__@localhost:5432/dcode
REDIS_URL=redis://localhost:6379/0
RABBITMQ_USER=dcode
RABBITMQ_PASSWORD=__SET_LOCAL_DEV_RABBITMQ_PASSWORD__
RABBITMQ_URL=amqp://dcode:__SET_LOCAL_DEV_RABBITMQ_PASSWORD__@localhost:5672/
AGENT_URL=http://localhost:8001

# --- CORS for the frontend (comma-separated list) ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=info

# --- Internal service auth ---
INTERNAL_API_KEY=__SET_LOCAL_DEV_INTERNAL_API_KEY__

# ============================================================
# Open Decisions placeholders (see docs/PLAN.md §9).
# OD-1 (target repo) and OD-5 (domain) are not env vars.
# ============================================================

# OD-2: Embedding model. Default to 'stub' for low-resource local development.
# A real HTTP sidecar client is implemented; enable it explicitly before indexing.
EMBEDDING_MODEL=stub
EMBEDDING_DIM=1024
# When EMBEDDING_MODEL is not stub, point worker + API at the embedding sidecar:
# EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
# EMBEDDING_DIM=768   # MUST match the model (Jina v2 = 768, not 1024)
# EMBEDDING_ENDPOINT=http://host.docker.internal:8002
# EMBEDDING_BATCH_SIZE=1
# EMBEDDING_MAX_SEQ_LENGTH=1024   # caps Jina token window to avoid OOM (0 = disable)
# EMBEDDING_MAX_RETRIES=12        # sized for a cold CPU sidecar, not for an API
# EMBEDDING_TIMEOUT_SECONDS=300   # ditto — their product is the worst-case stall,
#                                 # and the worker consumes one job at a time
#
# Or reach the SAME model through Jina's hosted API instead of running it.
# EMBEDDING_PROVIDER selects HOW the model is reached, never WHICH model runs:
# keeping jina-embeddings-v2-base-code on both paths is what keeps the displayed
# evaluation figures a description of the running system (Deploy.md §2).
# Note the bare model id — the API does not take the Hugging Face `jinaai/` path.
# Switch as a SET; leaving the sidecar retry budget in place points an hour of
# patience at a service that fails in seconds.
# EMBEDDING_PROVIDER=jina_api
# EMBEDDING_API_KEY=jina_...
# EMBEDDING_ENDPOINT=https://api.jina.ai/v1
# EMBEDDING_MODEL=jina-embeddings-v2-base-code
# EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_TIMEOUT_SECONDS=30
# On MacBook: run `make embedding-host` in a separate terminal (recommended).
# Or Docker sidecar: docker compose --profile embedding up -d embedding
# If you change EMBEDDING_DIM after first migrate: make down-all && make migrate

# Hybrid RRF fusion weights (mode=hybrid). Dense > sparse reduces keyword noise.
# RRF_DENSE_WEIGHT=2.0
# RRF_SPARSE_WEIGHT=1.0

# OD-3: Reranker (cross-encoder). Default to 'stub' for identity rerank
# (fused-score order). A real HTTP sidecar client is implemented.
# For B3/B4 eval quality, enable a real model — identity rerank alone cannot
# recover from noisy fusion. OD-3 default is BGE; MiniLM is a lighter option.
RERANKER_MODEL=stub
# When RERANKER_MODEL is not stub, point API at the reranker sidecar:
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# # or: RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_ENDPOINT=http://host.docker.internal:8003
# RERANKER_CANDIDATE_LIMIT=16   # kept small so BGE reranks within the interactive budget on CPU
# RERANKER_MAX_SEQ_LENGTH=512
#
# Or reach the SAME model through SiliconFlow's hosted API.
# Their two platforms are independent: api.siliconflow.cn serves
# BAAI/bge-reranker-v2-m3, api.siliconflow.com served only Qwen rerankers when
# this was written, and keys are NOT interchangeable — a .com key on .cn returns
# 401. The model this project needs is the one the evaluation used, so .cn it is.
# RERANKER_PROVIDER=siliconflow
# RERANKER_API_KEY=sk-...
# RERANKER_ENDPOINT=https://api.siliconflow.cn/v1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# On MacBook: run `make reranker-host` in a separate terminal (recommended).
# Or Docker sidecar: docker compose --profile reranker up -d reranker

# OD-4: Judge model for the evaluation harness. Placeholder until M3.
JUDGE_MODEL=stub

# P1-4: LLM answer synthesis. Default 'stub' keeps rule-based template answers
# (the agent lists WHERE the relevant code is). Set an OpenAI model + key to get
# prose explanations grounded in the retrieved code — citations are still
# verified against the index by the groundedness guardrail.
SYNTHESIS_MODEL=stub
# SYNTHESIS_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=            # optional: OpenAI-compatible endpoint (Azure, etc.)
# SYNTHESIS_MAX_TOKENS=700
# SYNTHESIS_TEMPERATURE=0.1

# Groundedness guardrail (D-2.3.1). The agent redacts any final-answer code
# reference not found in the index; answers scoring below this fraction carry
# an explicit warning. Keep > 0 in production so the guardrail stays enforced.
# GROUNDEDNESS_THRESHOLD=0.95

# --- Evaluation harness: B0 GitHub code search ---
# Only read by the B0 baseline in apps/eval, via os.environ — not by any
# service. Searching a PUBLIC repository needs no scopes at all; the token
# exists purely to raise the rate limit, so issue one with nothing ticked.
#
# Left empty, B0 reports as **unmeasured** rather than scoring zero. That
# distinction is load-bearing: an unmeasured baseline is an honest blank, and
# a zero is a claim about GitHub Search that we would not have earned.
#
# B0 queries a live external service, so unlike every other figure in this
# project its result cannot be regenerated from committed bytes — only
# re-queried, against an index that may have moved. It is a retrieval
# reference and is not part of the H1 decision.
GITHUB_TOKEN=
